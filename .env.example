# Resume Skill Gap Analyzer — Environment Configuration
# -------------------------------------------------------
# Copy this file to .env and adjust values if needed.
#
# NOTE: No API key is required. The app uses a locally-running
# Ollama instance for AI analysis — completely free and private.

# Port the Express server listens on (default: 3000)
PORT=3000

# URL of your local Ollama API (default — no need to change unless you moved it)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Model to use for analysis.
# llama3.2:3b  — recommended: fast, ~2 GB download, works well on 16 GB RAM
# llama3.1:8b  — higher quality, ~5 GB download, needs 8+ GB free RAM
# mistral:7b   — alternative, ~4 GB download, also good quality
OLLAMA_MODEL=llama3.2:3b
